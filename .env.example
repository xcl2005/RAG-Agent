# ---------- LLM provider ----------
# `responses` uses OpenAI's current Responses API. Use `chat_completions`
# only for an OpenAI-compatible provider that does not implement Responses.
LLM_API_MODE=responses
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5.6-luna
LLM_STORE_RESPONSES=false
MAX_PLAN_OUTPUT_TOKENS=600
MAX_ANSWER_OUTPUT_TOKENS=1200
MAX_REPAIR_OUTPUT_TOKENS=1200

# ---------- Retrieval ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks_v2
SQLITE_PATH=storage/rag.db
CHECKPOINT_PATH=storage/checkpoints.db

# The lightweight defaults run on a laptop. See docs/tuning.md for a
# higher-quality BGE-M3 profile.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ENABLE_RERANKER=true
# The default CrossEncoder emits logits. Choose `probability` only for a model
# whose documentation guarantees a [0,1] output.
RERANKER_SCORE_MODE=logit

CHUNK_SIZE=900
CHUNK_OVERLAP=150
DENSE_TOP_K=30
SPARSE_TOP_K=30
FUSION_TOP_K=20
RERANK_TOP_K=8
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0

# Adaptive retrieval retries with query expansion when evidence is weak.
MAX_RETRIEVAL_ATTEMPTS=2
MAX_QUERY_VARIANTS=3
MIN_RERANK_RELEVANCE=0.55
# Conservative BGE fallback; calibrate on your own labeled evaluation set.
MIN_DENSE_RELEVANCE=0.80
MIN_SPARSE_COVERAGE=0.45
MAX_CONTEXT_CHARS=12000

# ---------- API and safety ----------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated TrustedHostMiddleware allowlist. Avoid "*" on local desktops.
API_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
API_ACCESS_KEY=
# Enables the server-path ingestion/reset endpoint and is intentionally
# separate from the ordinary chat/upload key.
ADMIN_API_KEY=
MAX_QUESTION_CHARS=4000
MAX_UPLOAD_MB=20
MAX_UPLOAD_FILES=10
ALLOWED_INGEST_ROOT=data/raw
LOG_LEVEL=INFO

# `stdio` is convenient for local MCP clients. `streamable-http` exposes /mcp.
MCP_TRANSPORT=stdio
